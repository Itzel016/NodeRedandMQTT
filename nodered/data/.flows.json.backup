    {
        "id": "16dc7bcbb25922c9",
        "type": "function",
        "z": "72193077ed2e69d9",
        "name": "GeneradorDatos",
        "func": "let temperatura = 20 + Math.random() * 10;\nlet humedad = 45 + Math.random() * 25;\n\nmsg.payload = {\n    dispositivo: \"ESP32_DHT11\",\n    sensor: \"DHT11\",\n    temperatura: Number(temperatura.toFixed(1)),\n    humedad: Number(humedad.toFixed(1))\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 340,
        "wires": [
            [
                "21428786df8256a2"
            ]
        ]
    },
