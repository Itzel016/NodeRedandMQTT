    {
        "id": "b65a7af96026297a",
        "type": "function",
        "z": "72193077ed2e69d9",
        "name": "procesarDTH11",
        "func": "let datos = msg.payload;\n\nmsg.temperatura = datos.temperatura;\nmsg.humedad = datos.humedad;\nmsg.dispositivo = datos.dispositivo;\nmsg.sensor = datos.sensor;\n\nreturn msg;",
